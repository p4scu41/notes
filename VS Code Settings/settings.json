{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  "[vue]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
    // "editor.defaultFormatter": "Vue.volar"
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off"
  },
  "accessibility.signals.chatRequestSent": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off"
  },
  "accessibility.signals.clear": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off"
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off"
  },
  "accessibility.signals.diffLineDeleted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineInserted": {
    "sound": "off"
  },
  "accessibility.signals.diffLineModified": {
    "sound": "off"
  },
  "accessibility.signals.editsKept": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.editsUndone": {
    "announcement": "auto",
    "sound": "off"
  },
  // "Laravel.pint.runOnSave": true,
  // "phpstan.dockerContainerName": "fpm",
  "accessibility.signals.lineHasBreakpoint": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.lineHasError": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.lineHasFoldedArea": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off"
  },
  "accessibility.signals.lineHasWarning": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.noInlayHints": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.notebookCellCompleted": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.notebookCellFailed": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.onDebugBreak": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.positionHasError": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.positionHasWarning": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.progress": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.taskCompleted": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.taskFailed": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.terminalBell": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.terminalCommandFailed": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.terminalCommandSucceeded": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.terminalQuickFix": {
    "announcement": "auto",
    "sound": "off"
  },
  "accessibility.signals.voiceRecordingStarted": {
    "sound": "off"
  },
  "accessibility.signals.voiceRecordingStopped": {
    "sound": "off"
  },
  "apc.stylesheet": {
    ".anysphere-markdown-container-root": "font-size: 15px !important; line-height: 1.5 !important;"
    // ".view-line": "font-size: 14px !important;",
    // ".aislash-editor-input": "font-size: 15px !important; line-height: 1.5 !important;"
  },
  "breadcrumbs.enabled": false,
  "cSpell.userWords": [
    "aryeo",
    "Batchable",
    "Deven",
    "Dispatchable",
    "Esoft",
    "fakerphp",
    "Fonseca",
    "fulltext",
    "Geospatial",
    "healthcheck",
    "Hemphill",
    "Holmen",
    "inertiajs",
    "Jahnke",
    "Jetstream",
    "larastan",
    "laravel",
    "Livewire",
    "Mailables",
    "mailpit",
    "Mazelin",
    "meilisearch",
    "nunomaduro",
    "Nylas",
    "oklch",
    "Parkes",
    "pascual",
    "Pastena",
    "pestphp",
    "pgsql",
    "phpstan",
    "phpunit",
    "Queueable",
    "Quickbooks",
    "Quinlan",
    "Rosenwald",
    "showingtimeplus",
    "Sotolongo",
    "Spatie",
    "STREAMZ",
    "tightenco",
    "vite",
    "VSAI",
    "wayfinder"
  ],
  "css.format.spaceAroundSelectorSeparator": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.accessibilitySupport": "on",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.defaultFormatter": "prettier.prettier-vscode",
  "editor.fontLigatures": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modifications",
  "editor.guides.bracketPairs": true,
  "editor.lineHeight": 23,
  "editor.minimap.enabled": false,
  "editor.snippetSuggestions": "top",
  "editor.suggest.localityBonus": true,
  "editor.suggest.showKeywords": false,
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 185,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "vue": "html",
    "vue-html": "html"
  },
  "eslint.format.enable": true,
  "eslint.validate": [
    "html",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "vue-html"
  ],
  "explorer.autoReveal": false,
  "files.associations": {
    "*.mdx": "markdown"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.blame.editorDecoration.enabled": true,
  "git.openRepositoryInParentFolders": "never",
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.changesDiff": "hunk",
  "javascript.format.semicolons": "insert",
  "javascript.preferences.quoteStyle": "single",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "Laravel.phpEnvironment": "local",
  // "jest.runMode": "on-demand",
  // "laravel-pint-fixer.pintBinPath": "~/.composer/vendor/bin/pint",
  // "laravel-pint-fixer.pintConfigPath": "/Users/pascual/Herd/pint.json",
  "less.format.spaceAroundSelectorSeparator": true,
  "php.suggest.basic": false,
  "php.validate.executablePath": "/usr/local/bin/php",
  "phpunit.args": [
    "--stop-on-failure",
    "--colors"
  ],
  "phpunit.command": "tripod run fpm ${php} ${phpargs} ${phpunit} ${phpunitargs}",
  "phpunit.paths": {
    "${workspaceFolder}": "/var/www/html"
  },
  "phpunit.phpunit": "artisan test",
  // "phpstan.binCommand": ["~/.composer/vendor/bin/phpstan"],
  // "phpstan.checkValidity": true,
  // "phpstan.configFile": "~/Herd/phpstan.neon,phpstan.neon,phpstan.neon.dist,phpstan.dist.neon",
  // "phpstan.memoryLimit": "2G",
  // "playwright.reuseBrowser": true,
  "prettier.jsxSingleQuote": true,
  "prettier.singleQuote": true,
  "scm.autoReveal": false,
  "scss.format.spaceAroundSelectorSeparator": true,
  "search.mode": "newEditor",
  "search.showLineNumbers": true,
  "security.workspace.trust.untrustedFiles": "open",
  "telemetry.telemetryLevel": "error",
  "typescript.format.semicolons": "insert",
  "typescript.preferences.quoteStyle": "single",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.commandCenter": true,
  "window.title": "${dirty}${activeFolderMedium}",
  "workbench.colorCustomizations": {
    "tab.activeBackground": "#252825"
  },
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.wrapTabs": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 15,
  "workbench.tree.renderIndentGuides": "always"
}
